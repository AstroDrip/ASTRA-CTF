# ==============================================================================
# ASTRA // ECHO CTF - Environment Configuration
# ==============================================================================
# NOTE: All variables below are OPTIONAL for local development.
# If omitted, ASTRA runs in standalone mode storing data locally in .data/ctf_store.json.
# ==============================================================================

# --- Admin & Instructor Controls ---
# Passcode required to access the Instructor Admin panel (/admin)
# Default fallback if unset: ASTRA_ADMIN_2026
ADMIN_SECRET=ASTRA_ADMIN_2026

# --- Supabase Cloud Multiplayer (Optional) ---
# Required only if you want persistent cloud multiplayer / Vercel deployment.
# Run the migration in `supabase/001_astra_multiplayer.sql` in your Supabase SQL Editor first.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- Server Port (Optional) ---
PORT=3000
